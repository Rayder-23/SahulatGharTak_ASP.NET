@model HomeServicesPortal.Models.ViewModels.ServiceProviderFormVm
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Job Provider";
    var activeTab = ViewBag.ActiveTab as string ?? "provider";
    var docsActive = string.Equals(activeTab, "documents", StringComparison.OrdinalIgnoreCase);
}

<style>
    .sp-edit-tabs .nav-link { font-size: 0.9rem; }
</style>

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none text-muted small"><i class="fa-solid fa-arrow-left me-1"></i>Back to Job Providers</a>
    <h2 class="mt-1 mb-0 h4"><i class="fa-solid fa-pen me-2 text-primary"></i>Edit Job Provider <span class="text-muted fw-normal">#@Model.Uid</span></h2>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card hs-card">
    <div class="card-header bg-white border-bottom-0 pb-0">
        <ul class="nav nav-tabs sp-edit-tabs card-header-tabs" id="providerEditTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(docsActive ? "" : "active")" id="provider-edit-tab" data-bs-toggle="tab" data-bs-target="#provider-edit-pane"
                        type="button" role="tab" aria-controls="provider-edit-pane" aria-selected="@(!docsActive)">
                    <i class="fa-solid fa-user-tie me-1"></i>Provider Details
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(docsActive ? "active" : "")" id="documents-edit-tab" data-bs-toggle="tab" data-bs-target="#documents-edit-pane"
                        type="button" role="tab" aria-controls="documents-edit-pane" aria-selected="@docsActive">
                    <i class="fa-solid fa-file-signature me-1"></i>Legal Documents
                    @if (Model.IsVerified)
                    {
                        <span class="badge bg-success ms-1">Verified</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-1">Pending</span>
                    }
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-3">
        <div class="tab-content" id="providerEditTabContent">
            <div class="tab-pane fade @(docsActive ? "" : "show active")" id="provider-edit-pane" role="tabpanel" aria-labelledby="provider-edit-tab" tabindex="0">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" data-valmsg-summary="true"></div>
                <form asp-action="Edit" asp-route-id="@Model.Uid" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Uid" />
                    <partial name="_FormFields" model="Model" />
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-save me-1"></i>Update Provider</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            </div>

            <div class="tab-pane fade @(docsActive ? "show active" : "")" id="documents-edit-pane" role="tabpanel" aria-labelledby="documents-edit-tab" tabindex="0">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
                <form asp-action="SaveDocuments" asp-route-id="@Model.Uid" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <partial name="_DocumentFormFields" model="Model.DocumentForm" />
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="fa-solid fa-save me-1"></i>
                            @(Model.DocumentForm.Uid > 0 ? "Update Documents" : "Save Documents")
                        </button>
                        @if (Model.DocumentForm.Uid > 0)
                        {
                            <a asp-controller="ProviderDocuments" asp-action="Details" asp-route-id="@Model.DocumentForm.Uid" class="btn btn-outline-secondary btn-sm">
                                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Open full record
                            </a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
